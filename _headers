# Cloudflare Pages / Workers assets read this file automatically.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # SAMEORIGIN (not DENY) so Knight can show its own Notes and Arcade pages inside itself.
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(self), microphone=(self), camera=(self), gamepad=(self), autoplay=(self)

# Don't let browsers or the CDN cache the files you edit most.
/index.html
  Cache-Control: no-cache
/notes.html
  Cache-Control: no-cache
/arcade.html
  Cache-Control: no-cache
/config.js
  Cache-Control: no-cache
/script.js
  Cache-Control: no-cache
/puter-guard.js
  Cache-Control: no-cache
