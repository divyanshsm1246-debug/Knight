<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build for KnightBackendApplication.java.

  WHERE THIS GOES
  ================
  A Maven project needs this exact layout:

      knight-backend/
        pom.xml                                           (this file)
        src/main/java/com/knight/backend/
          KnightBackendApplication.java                    (the file I gave you earlier)
        src/main/resources/
          application.properties                           (the file I gave you alongside this one)

  Put KnightBackendApplication.java at that exact path (note the package
  folders matching its "package com.knight.backend;" line) and
  application.properties at that exact path, then:

      mvn spring-boot:run          (run it locally to test)
      mvn clean package            (produces target/knight-backend-1.0.0.jar)

  DEPLOYING (Render, as an example)
  ===================================
  1. Push this whole folder to a GitHub repo.
  2. On Render: New, Web Service, connect that repo.
  3. Build command:  mvn clean package -DskipTests
  4. Start command:  java -jar target/knight-backend-1.0.0.jar
  5. PORT is set automatically by Render; the app already reads it
     (see application.properties).
  6. Once it's live, copy the URL Render gives you (e.g.
     https://knight-backend-xxxx.onrender.com) into Knight's
     Settings and Guides, Cloud Connection, Java Backend URL,
     then hit Save and Connect.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.knight</groupId>
  <artifactId>knight-backend</artifactId>
  <version>1.0.0</version>
  <name>knight-backend</name>
  <description>Knight's Java REST backend: accounts, projects, deployment, analytics, presence.</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Dev/default database: a real file on disk, so accounts survive a restart.
         Swap for postgresql below when you outgrow a single instance. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!--
    Uncomment for production on Render/Railway/etc with a managed Postgres:
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
    -->

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>knight-backend-1.0.0</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
