<?xml version="1.0" encoding="UTF-8"?>
<!--
  Maven build for the Knight backend.

  Layout this file expects (already set up in the repo you were given):
      backend/pom.xml
      backend/Dockerfile
      backend/src/main/java/com/knight/backend/KnightBackendApplication.java
      backend/src/main/resources/application.properties

  Local run:   mvn spring-boot:run
  Build jar:   mvn clean package   (produces target/knight-backend-1.0.0.jar)
  On Render the Dockerfile in this folder runs that build for you.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.knight</groupId>
  <artifactId>knight-backend</artifactId>
  <version>1.0.0</version>
  <name>knight-backend</name>
  <description>Knight's Java REST backend: accounts, projects, deployment, analytics, presence, feedback.</description>

  <properties>
    <java.version>17</java.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>

    <!-- Local development database (a file on your own computer). -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Real hosting: Postgres (Neon, Supabase, Render Postgres). Used whenever
         the DATABASE_URL environment variable is set. -->
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>knight-backend-1.0.0</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
